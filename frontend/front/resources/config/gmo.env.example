# Configuración de GMO para Electron. Copia este fichero a gmo.env (está en .gitignore).
#
# Dónde se busca gmo.env, por prioridad:
#   1. %APPDATA%/GMO/gmo.env         (configuración del propio equipo)
#   2. <instalación>/resources/config/gmo.env  (la que se empaqueta con el instalador)
#   3. frontend/front/resources/config/gmo.env (desarrollo)
#
# El secreto JWT NO va aquí: Electron genera uno por instalación en %APPDATA%/GMO/jwt.secret.

# --- Opción A: MySQL local con Docker (por defecto) ---------------------------------
MYSQL_ROOT_PASSWORD=cambia-esto
DB_USERNAME=gmo_dev
DB_PASSWORD=cambia-esto

# --- Opción B: AWS RDS (Electron no arranca Docker) ---------------------------------
# DB_URL=jdbc:mysql://<endpoint-rds>:3306/tfgapp_db?sslMode=REQUIRED
# DB_USERNAME=gmo_app
# DB_PASSWORD=<contraseña del usuario app>
# El usuario "app" no tiene permisos de esquema: las migraciones las aplica el desarrollador.
# DB_MIGRATE=false

# --- Fotos de perfil ----------------------------------------------------------------
PROFILE_IMAGES_MODE=local
# PROFILE_IMAGES_MODE=s3
# PROFILE_IMAGES_SIGNER_URL=https://<id>.lambda-url.<region>.on.aws/
# PROFILE_IMAGES_SIGNER_KEY=<clave-compartida-con-la-lambda>

# Opcional: cada cuántos segundos se resincronizan los eventos FOCUS/MANDATORY (por defecto 120).
# EVENTS_SCHEDULE_SYNC_SECONDS=120
