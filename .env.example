# OPCIONAL. Sin este fichero, docker compose y el backend usan el MySQL local de Docker con
# sus credenciales de desarrollo por defecto. Cópialo a .env (está en .gitignore) solo para
# apuntar a RDS o cambiar algo. Lo leen docker compose (compose.yml) y el backend al
# arrancarlo desde backend/ o desde la raíz (IDE, mvnw spring-boot:run).
#
# MySQL local: MySQL solo aplica estas credenciales la primera vez que inicializa el volumen,
# así que con la BD ya creada déjalas comentadas.
# MYSQL_ROOT_PASSWORD=admin
# DB_USERNAME=rmgadmin
# DB_PASSWORD=africa

# Opcional: apunta a RDS en lugar del MySQL local (ver docs/AWS_SETUP.md).
# DB_URL=jdbc:mysql://<endpoint-rds>:3306/gmoapp_db?sslMode=REQUIRED

# Opcional en desarrollo (hay uno por defecto); Electron genera el suyo por instalación.
# JWT_SECRET=pon-aqui-un-secreto-aleatorio-de-al-menos-32-caracteres

# Fotos de perfil: local | s3
PROFILE_IMAGES_MODE=local
# PROFILE_IMAGES_SIGNER_URL=https://<id>.lambda-url.<region>.on.aws/
# PROFILE_IMAGES_SIGNER_KEY=<clave-compartida-con-la-lambda>
