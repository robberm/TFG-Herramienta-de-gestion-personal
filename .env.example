# Copia este fichero a .env (está en .gitignore) para desarrollo local.
# Lo leen docker compose (compose.yml) y el backend al arrancarlo desde backend/ o desde la raíz.
#
# Si ya tienes la BD de Docker creada, pon aquí las credenciales con las que se creó:
# MySQL solo aplica estos valores la primera vez que inicializa el volumen.

MYSQL_ROOT_PASSWORD=cambia-esto
DB_USERNAME=gmo_dev
DB_PASSWORD=cambia-esto

# Opcional: apunta a RDS en lugar del MySQL local (ver docs/AWS_SETUP.md).
# DB_URL=jdbc:mysql://<endpoint-rds>:3306/tfgapp_db?sslMode=REQUIRED

# Obligatorio para arrancar el backend fuera de Electron (mínimo 32 caracteres).
JWT_SECRET=pon-aqui-un-secreto-aleatorio-de-al-menos-32-caracteres

# Fotos de perfil: local | s3
PROFILE_IMAGES_MODE=local
# PROFILE_IMAGES_SIGNER_URL=https://<id>.lambda-url.<region>.on.aws/
# PROFILE_IMAGES_SIGNER_KEY=<clave-compartida-con-la-lambda>
